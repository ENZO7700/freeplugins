rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if the user is the owner of the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users can read and update their own profile data
    match /users/{userId} {
      allow read, update: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn(); // Allow creation upon signup
    }

    // Plugins and blog posts are public and can be read by anyone. No client-side writes.
    match /plugins/{pluginId} {
      allow read: if true;
      allow write: if false; 

      // Reviews can be created by any signed-in user.
      // They can only be read publicly. Updates/deletes should be handled server-side or via moderation tools.
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if false; // Prevent users from editing/deleting reviews directly
      }
    }

    // Users can only read their own orders.
    // Order creation is handled by the backend/server-side logic.
    match /orders/{orderId} {
      allow read: if isSignedIn() && isOwner(resource.data.userId);
      allow create, update, delete: if false; // All mutations must be from a trusted server environment
    }

    // Users can only read their own license keys.
    // License key creation is handled by the backend.
    match /licenseKeys/{keyId} {
        allow read: if isSignedIn() && isOwner(resource.data.userId);
        allow create, update, delete: if false;
    }
  }
}
