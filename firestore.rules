
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is the owner of a document
    function isOwner(resourceId) {
      return request.auth.uid == resourceId;
    }

    // Helper function to check if a user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Plugins can be read by anyone, but only admins (or vendors in a real app) can write.
    // For this prototype, we'll keep it simple and lock it down.
    match /plugins/{pluginId} {
      allow read: if true;
      allow write: if false; // In a real app, this would check for an admin or vendor role
    }

    // Orders can only be created by authenticated users for themselves.
    // They can only be read by the user who created them.
    match /orders/{orderId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if false;
    }
    
    // License keys can only be read by the user who owns them.
    // They are created and managed by Cloud Functions, so client-side write access is disabled.
    match /licenseKeys/{licenseKeyId} {
      allow read: if isOwner(resource.data.userId);
      allow write: if false;
    }
  }
}

    